@inherits LayoutComponentBase
@using OpticaSosa.Application.Business
@inject IBusinessSettingsService Business

<div class="app-shell">
    <OpticaSosa.Web.Components.Navigation.PrimaryNavigation />
    <div class="app-content"><BusinessHeader Branding="Branding" />@Body</div>
</div>

@code {
    private BusinessBranding Branding = BusinessBranding.Default;
    protected override async Task OnInitializedAsync() => Branding = await Business.GetBrandingAsync();
}
