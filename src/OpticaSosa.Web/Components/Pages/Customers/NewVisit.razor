@page "/clientes/{Id:guid}/visitas/nueva"
@attribute [Authorize(Policy = Permissions.WriteCustomers)]
@inject ICustomerService Customers
@inject IVisitService Visits
@inject NavigationManager Navigation

<BusinessPageTitle Text="Iniciar visita" />
<main>
    <CustomerNavigation />
    <h1>Iniciar visita</h1>
    @if (Details is null) { <p>El cliente no existe.</p> }
    else
    {
        <p>@Details.Customer.LastName, @Details.Customer.FirstName</p>
        <p>Registrá sólo el motivo y las observaciones administrativas. No incluyas diagnósticos ni información médica.</p>
        @if (!Details.Customer.IsActive) { <p role="alert">Este cliente está inactivo.</p> }
        <EditForm Model="Input" FormName="visit-start" OnValidSubmit="StartAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <input type="hidden" name="Input.SubmissionId" value="@Input!.SubmissionId" />
            <input type="hidden" name="Input.CustomerVersion" value="@Input!.CustomerVersion" />
            <label for="reason">Motivo administrativo *</label>
            <InputText id="reason" @bind-Value="Input!.Reason" maxlength="100" required />
            <label for="notes">Observaciones administrativas</label>
            <InputTextArea id="notes" @bind-Value="Input!.AdministrativeNotes" maxlength="500" />
            @if (Result?.Error is not null) { <p role="alert">@Result.Error</p> }
            <button type="submit" disabled="@(!Details.Customer.IsActive)">Iniciar visita</button>
            <a href="@($"/clientes/{Id}")">Volver a la ficha</a>
        </EditForm>
    }
</main>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromForm(FormName = "visit-start")] public VisitInput? Input { get; set; }
    private CustomerDetails? Details;
    private CustomerResult? Result;
    protected override async Task OnInitializedAsync()
    {
        Details = await Customers.GetAsync(Id);
        Input ??= new() { CustomerVersion = Details?.Version ?? Guid.Empty };
    }
    private async Task StartAsync()
    {
        Result = await Visits.StartAsync(Id, Input!);
        if (Result.Succeeded) Navigation.NavigateTo($"/clientes/{Id}", forceLoad: true);
    }
}
