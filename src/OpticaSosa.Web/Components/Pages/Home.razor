@page "/"
@attribute [Authorize]
@using OpticaSosa.Web.Components.Navigation
@inject OpticaSosa.Application.Security.ICurrentUser Current
<BusinessPageTitle Text="Inicio" />
<main>
    <div class="page-heading"><div><p class="eyebrow">Tu espacio de trabajo</p><h1>Todo conectado.<br />Una atención más simple.</h1>
        <p>Comenzá por la ficha del cliente y seguí cada atención, documento y trabajo desde el mismo lugar.</p></div><span class="welcome-mark" aria-hidden="true">◈</span></div>
    <div class="dashboard-grid">
        @foreach (var item in NavigationItems.For(Current).Where(x => x.Path != "/"))
        {
            <a class="dashboard-card" href="@item.Path" data-enhance-nav="false"><span class="card-mark">@item.Mark</span><h2>@item.Label</h2><p>@item.Description</p><span class="card-action">Abrir sección <span aria-hidden="true">↗</span></span></a>
        }
    </div>
    <p class="environment-note">Una base centralizada · Registros con historial · Usá sólo datos ficticios durante el desarrollo.</p>
</main>
