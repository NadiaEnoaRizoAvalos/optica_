@inject OpticaSosa.Application.Business.IBusinessSettingsService Business
@{ var branding = await Business.GetBrandingAsync(); }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @branding.DisplayName</title><link rel="stylesheet" href="/app.css" />
</head>
<body>
    <div class="app-shell @(User.Identity?.IsAuthenticated == true ? "" : "anonymous-shell")">
        <component type="typeof(OpticaSosa.Web.Components.Navigation.PrimaryNavigation)" render-mode="Static" />
        <div class="app-content">
            <component type="typeof(OpticaSosa.Web.Components.Business.BusinessHeader)" render-mode="Static" param-Branding="branding" />
            <main>@RenderBody()</main>
        </div>
    </div>
    <script src="/app.js" defer></script>
</body>
</html>
