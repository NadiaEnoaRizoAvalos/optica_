@page "/cuenta/clave"
@model OpticaSosa.Web.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<h1>Cambiar mi contraseña</h1>
<p>Usá al menos 12 caracteres con mayúscula, minúscula, número y símbolo. Al guardar tendrás que volver a ingresar.</p>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <label asp-for="CurrentPassword">Contraseña actual</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required />
    <label asp-for="NewPassword">Nueva contraseña</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="256" required />
    <label asp-for="Confirmation">Repetir nueva contraseña</label>
    <input asp-for="Confirmation" type="password" autocomplete="new-password" maxlength="256" required />
    <button type="submit">Guardar contraseña</button>
</form>
