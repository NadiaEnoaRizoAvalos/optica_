@page "/pedidos/{id:guid}"
@using OpticaSosa.Domain.Work
@using OpticaSosa.Web.Pages.Work
@model DetailsModel
@{ var d = Model.Details; var w = d.Work; ViewData["Title"] = "Ficha de pedido"; }
<p class="eyebrow">Pedido @w.Id</p><h1>@w.Product</h1><p><a href="/clientes/@w.CustomerId">@w.CustomerName</a> · @w.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
<span class="status-badge">@WorkDisplay.Status(w.Status)</span><p>@WorkDisplay.Type(w.Type) · Armazón: @w.Frame · Ronda de revisión @w.Round</p>
@if (d.PrescriptionId.HasValue) { <a href="/clientes/@w.CustomerId/clinica/@d.PrescriptionId?revision=@d.PrescriptionRevisionNumber">Consultar receta fijada · versión @d.PrescriptionRevisionNumber</a> }
<div asp-validation-summary="All" role="alert"></div>
<section><h2>Seguimiento</h2><div class="stats-grid"><div>Control técnico <strong>@(w.TechnicalApproved ? "Aprobado" : "Pendiente")</strong></div><div>Control previo a entrega <strong>@(w.DeliveryApproved ? "Aprobado" : "Pendiente")</strong></div></div>
@if (w.Status != WorkStatus.Delivered && Model.Can(Permissions.WriteOrders)) { <p><a href="/pedidos/nuevo/@w.Id">Editar especificaciones</a></p> }
<form method="post"><input asp-for="Version" type="hidden" />
@if (w.Status == WorkStatus.Registered) { <button name="Command" value="prepare">Comenzar preparación</button> }
@if (w.Status == WorkStatus.InPreparation) { <button name="Command" value="control">Enviar a control</button> }
@if (w.Status == WorkStatus.Observed) { <p>Corregí las observaciones antes de iniciar una nueva ronda; se conservarán todos los controles.</p><button name="Command" value="correct">Iniciar corrección</button> }
@if (w.Status == WorkStatus.ReadyForDelivery && Model.Can(Permissions.DeliverOrders)) { <button name="Command" value="deliver">Registrar entrega</button> }
</form>
@if (w.Status is WorkStatus.PendingControl or WorkStatus.ReadyForDelivery) { <nav>
@if (Model.Can(Permissions.TechnicalControl) && (!QualityCatalog.RequiresProfessional(w.Type) || Model.Can(Permissions.WriteClinical))) { <a class="button-link" href="/pedidos/@w.Id/control?etapa=0">Control técnico</a> }
@if (Model.Can(Permissions.DeliveryControl)) { <a class="button-link" href="/pedidos/@w.Id/control?etapa=1">Control previo a entrega</a> }</nav> }
<p><a href="#historial">Consultar historial</a></p></section>
<section id="historial"><h2>Historial de controles · @d.ControlCount visibles según permisos</h2>
@foreach (var c in d.Controls) { <details class="control-history"><summary>@WorkDisplay.Stage(c.Stage) · @WorkDisplay.Control(c.Status) · ronda @c.Round · @c.AtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</summary>
<p>Control @c.Id · Responsable @c.ActorId · @(c.Role == ResponsibleRole.Professional ? "Profesional" : "Atención/Ventas")</p><p>Aprobación: @(c.ApprovedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Sin aprobar")</p><p>@c.Notes</p>
@foreach (var i in c.Items) { <p><strong>@i.Label:</strong> @WorkDisplay.Check(i.Status) · @i.Notes</p> }</details> }
@if (d.Controls.Count == 0) { <p>Sin controles visibles registrados.</p> }
<h2>Historial de estados y operaciones</h2>@foreach (var t in d.Transitions) { <p>@t.AtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · @WorkDisplay.Status(t.From) → @WorkDisplay.Status(t.To) · Usuario @t.ActorId · @t.Action</p> }
<nav>@if (d.Page > 1) { <a href="?pagina=@(d.Page - 1)#historial">Más recientes</a> }@if (d.HasMoreControls || d.HasMoreTransitions) { <a href="?pagina=@(d.Page + 1)#historial">Más antiguos</a> }</nav></section>
